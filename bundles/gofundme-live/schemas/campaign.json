{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "raised": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "goal": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "percent": {
      "type": "number",
      "minimum": 0
    },
    "goalOverridden": {
      "type": "boolean"
    },
    "donationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastUpdated": {
      "type": [
        "string",
        "null"
      ]
    },
    "connected": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "url",
    "title",
    "currency",
    "raised",
    "goal",
    "percent",
    "lastUpdated",
    "connected"
  ],
  "additionalProperties": false,
  "default": {
    "id": null,
    "url": "",
    "title": "Your next good thing starts here",
    "currency": "USD",
    "raised": 0,
    "goal": 0,
    "percent": 0,
    "lastUpdated": null,
    "connected": false
  }
}
