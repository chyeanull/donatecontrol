{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "enum": [
          "mock",
          "gofundme-pro",
          "donordrive",
          "givebutter"
        ]
      },
      "campaignUrl": {
        "type": "string",
        "maxLength": 2048
      },
      "campaignId": {
        "default": "",
        "type": "string",
        "maxLength": 40
      },
      "donorDriveResource": {
        "default": "participants",
        "type": "string",
        "enum": [
          "participants",
          "teams",
          "events"
        ]
      },
      "key": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "lastConnectedAt": {
        "type": "string"
      }
    },
    "required": [
      "provider",
      "campaignUrl",
      "campaignId",
      "key",
      "title",
      "lastConnectedAt"
    ],
    "additionalProperties": false
  },
  "default": []
}
