{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "campaignKey": {
        "type": "string"
      },
      "campaignTitle": {
        "type": "string"
      },
      "donation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "donorName": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "timestamp": {
            "type": "string"
          },
          "anonymous": {
            "type": "boolean"
          },
          "test": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "donorName",
          "amount",
          "currency",
          "timestamp",
          "anonymous"
        ],
        "additionalProperties": false
      },
      "donorName": {
        "type": "string"
      },
      "message": {
        "type": "string",
        "maxLength": 2000
      },
      "receivedAt": {
        "type": "string"
      },
      "editedAt": {
        "type": [
          "string",
          "null"
        ]
      },
      "sentCount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "lastSentAt": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "campaignKey",
      "campaignTitle",
      "donation",
      "donorName",
      "message",
      "receivedAt",
      "editedAt",
      "sentCount",
      "lastSentAt"
    ],
    "additionalProperties": false
  },
  "default": []
}
