{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "maxItems": 50,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "timestamp": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "level": {
        "type": "string",
        "enum": [
          "info",
          "error"
        ]
      }
    },
    "required": [
      "id",
      "timestamp",
      "message",
      "level"
    ],
    "additionalProperties": false
  },
  "default": []
}
