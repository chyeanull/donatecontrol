{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "configured": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "enum": [
        "none",
        "environment",
        "dashboard"
      ]
    },
    "saved": {
      "type": "boolean"
    },
    "storageError": {
      "type": "boolean"
    }
  },
  "required": [
    "configured",
    "source",
    "saved",
    "storageError"
  ],
  "additionalProperties": false,
  "default": {
    "configured": false,
    "source": "none",
    "saved": false,
    "storageError": false
  }
}
