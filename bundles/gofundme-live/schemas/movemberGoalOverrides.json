{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "campaignId": {
        "type": "string",
        "pattern": "^member\\/\\d+\\/\\d{4}$"
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "goal": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000000000000
      }
    },
    "required": [
      "campaignId",
      "currency",
      "goal"
    ],
    "additionalProperties": false
  },
  "default": []
}
