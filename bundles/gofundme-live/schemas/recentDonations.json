{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "maxItems": 50,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "donorName": {
        "type": "string"
      },
      "amount": {
        "type": "number",
        "minimum": 0,
        "maximum": 1000000000000
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "timestamp": {
        "type": "string"
      },
      "anonymous": {
        "type": "boolean"
      },
      "test": {
        "type": "boolean"
      },
      "message": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "required": [
      "id",
      "donorName",
      "amount",
      "currency",
      "timestamp",
      "anonymous"
    ],
    "additionalProperties": false
  },
  "default": []
}
